GROQ_API_KEY=your_groq_api_key_here
SESSION_DIR=./sessions

# Optional. Without it, jobs and plans are kept in memory. docker compose sets it for you.
# DATABASE_URL=postgresql+asyncpg://wayfarer:wayfarer-local@localhost:5432/wayfarer
# baseline or v2a
# WAYFARER_PLANNER=baseline
# Seconds a plan job may take, queue time included
# WAYFARER_PLAN_DEADLINE_S=120
